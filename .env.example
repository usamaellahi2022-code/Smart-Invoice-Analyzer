# Application configuration
APP_ENV=development
LOG_LEVEL=INFO

# Tesseract OCR installation
# Set these paths to your own Tesseract installation.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
TESSERACT_CMD=tesseract
TESSDATA_PREFIX=

# OCR language (eng = English)
OCR_LANGUAGE=eng

# Project-relative storage directories
UPLOAD_DIR=data/incoming
PROCESSED_DIR=data/processed
OUTPUT_DIR=outputs

# Maximum invoice upload size in MB
MAX_UPLOAD_SIZE_MB=20
# SQLite invoice history database
SMART_INVOICE_DB_PATH=data/invoice_history.sqlite3
